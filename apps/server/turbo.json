{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "$TURBO_EXTENDS$",
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "CORS_ORIGIN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "BASE_API_URL",
        "FRONTEND_URL",
        "JWT_SECRET"
      ]
    },
    "dev": {
      "env": [
        "$TURBO_EXTENDS$",
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "CORS_ORIGIN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "BASE_API_URL",
        "FRONTEND_URL",
        "JWT_SECRET"
      ]
    }
  }
}
